import ErdePaths.SourceClock

namespace ErdePaths.Profile
open SquareLift SourceClock

abbrev Vertex (N : Nat) := Fin N × Fin N

def height {N : Nat} (hN : 0<N) (u : Vertex N) : Fin N := forward hN u.1 u.2

def step {N : Nat} (hN : 0<N) (S : Fin N → Bool) (color : Bool) (u : Vertex N) : Vertex N :=
  if S (height hN u) ^^ color then (successor hN u.1,u.2) else (u.1,successor hN u.2)

theorem height_horizontal {N : Nat} (hN : 0<N) (u : Vertex N) :
    height hN (successor hN u.1,u.2)=successor hN (height hN u) := by
  apply Fin.ext
  simp only [height,forward,successor]
  rw [Nat.mod_add_mod,Nat.mod_add_mod]
  congr 1
  omega

theorem height_vertical {N : Nat} (hN : 0<N) (u : Vertex N) :
    height hN (u.1,successor hN u.2)=successor hN (height hN u) := by
  apply Fin.ext
  simp only [height,forward,successor]
  rw [Nat.add_mod_mod,Nat.mod_add_mod]
  congr 1

theorem height_step {N : Nat} (hN : 0<N) (S : Fin N → Bool) (color : Bool) (u : Vertex N) :
    height hN (step hN S color u)=successor hN (height hN u) := by
  unfold step
  split
  · exact height_horizontal hN u
  · exact height_vertical hN u

def previousStep {N : Nat} (hN : 0<N) (S : Fin N → Bool) (color : Bool) (u : Vertex N) : Vertex N :=
  if S (predecessor hN (height hN u)) ^^ color then (predecessor hN u.1,u.2)
  else (u.1,predecessor hN u.2)

theorem height_previous_horizontal {N : Nat} (hN : 0<N) (u : Vertex N) :
    height hN (predecessor hN u.1,u.2)=predecessor hN (height hN u) := by
  apply Fin.ext
  simp only [height,forward,predecessor]
  rw [Nat.mod_add_mod,Nat.add_mod_mod]
  congr 1
  omega

theorem height_previous_vertical {N : Nat} (hN : 0<N) (u : Vertex N) :
    height hN (u.1,predecessor hN u.2)=predecessor hN (height hN u) := by
  apply Fin.ext
  simp only [height,forward,predecessor]
  rw [Nat.add_mod_mod,Nat.add_mod_mod]
  congr 1
  omega

theorem step_previous {N : Nat} (hN : 0<N) (S : Fin N → Bool) (color : Bool) (u : Vertex N) :
    step hN S color (previousStep hN S color u)=u := by
  unfold previousStep
  split
  · simp only [step,height_previous_horizontal]
    rw [ite_eq_left (by assumption),successor_predecessor]
  · simp only [step,height_previous_vertical]
    rw [ite_eq_right (by assumption),successor_predecessor]

theorem previous_step {N : Nat} (hN : 0<N) (S : Fin N → Bool) (color : Bool) (u : Vertex N) :
    previousStep hN S color (step hN S color u)=u := by
  unfold previousStep
  rw [height_step,predecessor_successor]
  unfold step
  split
  · simp only [predecessor_successor,Prod.eta]
  · simp only [predecessor_successor,Prod.eta]

theorem step_bijective {N : Nat} (hN : 0<N) (S : Fin N → Bool) (color : Bool) :
    Function.Injective (step hN S color) ∧ Function.Surjective (step hN S color) := by
  constructor
  · intro u v he
    have hh := congrArg (previousStep hN S color) he
    simpa only [previous_step] using hh
  · intro u
    exact ⟨previousStep hN S color u,step_previous hN S color u⟩

/-- Clockwise actual edge label, retaining the imported torus decoder. -/
def stepLabel {N : Nat} (hN : 0<N) (S : Fin N → Bool) (color : Bool) (u : Vertex N) : TorusEdgeLabel N :=
  if S (height hN u) ^^ color then .inl (u.2,u.1) else .inr (u.1,u.2)

theorem step_decodes {N : Nat} (hN : 0<N) (S : Fin N → Bool) (color : Bool) (u : Vertex N) :
    decode hN (fun i : Fin N => i) (stepLabel hN S color u)=(u,step hN S color u) := by
  simp only [stepLabel,step]
  split <;> rfl

theorem labels_cover {N : Nat} (hN : 0<N) (S : Fin N → Bool) (e : TorusEdgeLabel N) :
    ∃ color u, stepLabel hN S color u=e := by
  cases e with
  | inl p =>
    refine ⟨!(S (height hN (p.2,p.1))),(p.2,p.1),?_⟩
    simp only [stepLabel,Bool.xor_not_self,↓reduceIte]
  | inr p =>
    refine ⟨S (height hN p),p,?_⟩
    simp only [stepLabel,Bool.xor_self,Bool.false_eq_true,↓reduceIte]

theorem labels_unique {N : Nat} (hN : 0<N) (S : Fin N → Bool) {color color' : Bool} {u v : Vertex N}
    (h : stepLabel hN S color u=stepLabel hN S color' v) : color=color' ∧ u=v := by
  unfold stepLabel at h
  split at h <;> split at h
  · have hv : u=v := by
      have hh : (u.2,u.1)=(v.2,v.1) := Sum.inl.inj h
      exact Prod.ext (congrArg Prod.snd hh) (congrArg Prod.fst hh)
    subst v
    have hc : color=color' := by
      cases hS : S (height hN u) <;> cases color <;> cases color' <;> simp_all
    exact ⟨hc,rfl⟩
  · cases h
  · cases h
  · have hv : u=v := Sum.inr.inj h
    subst v
    have hc : color=color' := by
      cases hS : S (height hN u) <;> cases color <;> cases color' <;> simp_all
    exact ⟨hc,rfl⟩

/-- Genuine torus adjacency, generated by the two coordinate cycle edges,
allowing orientation reversal. No profile edge coverage is assumed. -/
def TorusAdjacent {N : Nat} (hN : 0<N) (u v : Vertex N) : Prop :=
  ∃ e : TorusEdgeLabel N, SameEdge (decode hN (fun i : Fin N => i) e) (u,v)

theorem actual_edges_cover {N : Nat} (hN : 0<N) (S : Fin N → Bool) {u v : Vertex N}
    (h : TorusAdjacent hN u v) : ∃ color x, SameEdge (x,step hN S color x) (u,v) := by
  obtain ⟨e,he⟩ := h
  obtain ⟨color,x,hx⟩ := labels_cover hN S e
  rw [←hx,step_decodes] at he
  exact ⟨color,x,he⟩

theorem actual_edges_unique {N : Nat} (hN : 0<N) (h3 : 3≤N) (S : Fin N → Bool)
    {color color' : Bool} {u v : Vertex N}
    (h : SameEdge (u,step hN S color u) (v,step hN S color' v)) : color=color' ∧ u=v := by
  have he : SameEdge (decode hN (fun i : Fin N => i) (stepLabel hN S color u))
      (decode hN (fun i : Fin N => i) (stepLabel hN S color' v)) := by
    simpa only [step_decodes] using h
  exact labels_unique hN S (decode_edge_injective hN h3 (fun _ _ h => h) he)

theorem odd_coprime_power_two {k : Nat} (hk : k%2=1) (e : Nat) : Nat.Coprime k (2^e) := by
  have h2 : Nat.gcd k 2=1 := by
    rw [Nat.gcd_comm,Nat.gcd_rec,hk]
    rfl
  exact Nat.gcd_pow_right_of_gcd_eq_one h2

/-- Uniform odd multiplication cancellation in the actual finite round clock. -/
theorem odd_mul_mod_injective {k e : Nat} (hk : k%2=1) :
    Function.Injective (fun a : Fin (2^e) => (k*a.val)%(2^e)) := by
  intro a b he
  have hc := (odd_coprime_power_two hk e).symm
  have oneDirection (x y : Fin (2^e)) (hyx : y.val≤x.val)
      (he : (k*x.val)%(2^e)=(k*y.val)%(2^e)) : x=y := by
    have hd : 2^e∣k*x.val-k*y.val :=
      Nat.dvd_of_mod_eq_zero (Nat.sub_mod_eq_zero_of_mod_eq he)
    rw [←Nat.mul_sub_left_distrib] at hd
    have hh := hc.dvd_of_dvd_mul_left hd
    have hz := Nat.eq_zero_of_dvd_of_lt hh (show x.val-y.val<2^e by have := x.isLt; omega)
    apply Fin.ext
    omega
  by_cases h : b.val≤a.val
  · exact oneDirection a b h he
  · exact (oneDirection b a (by omega) he.symm).symm

private theorem bounded_mod {N x : Nat} (hx : x<2*N) :
    x%N=if x<N then x else x-N := by
  split
  · exact Nat.mod_eq_of_lt (by assumption)
  · rw [Nat.mod_eq_sub_mod (by omega),Nat.mod_eq_of_lt (by omega)]

private theorem two_lifts {M a b : Nat} (_hM : 0<M) (ha : a<2*M) (hb : b<2*M)
    (h : a%M=b%M) : a=b ∨ (a+M)%(2*M)=b := by
  rw [bounded_mod ha,bounded_mod hb] at h
  split at h <;> split at h
  · exact Or.inl (by omega)
  · apply Or.inr
    rw [Nat.mod_eq_of_lt (by omega)]
    omega
  · apply Or.inr
    rw [Nat.mod_eq_sub_mod (by omega),Nat.mod_eq_of_lt (by omega)]
    omega
  · exact Or.inl (by omega)

/-- Constructive bit lifting proves all rounds occur; no finite surjectivity
principle or assumed modular inverse is used. -/
theorem odd_mul_mod_surjective_nat {k : Nat} (hk : k%2=1) (e : Nat) :
    ∀ t, t<2^e → ∃ a, a<2^e ∧ (k*a)%(2^e)=t := by
  induction e with
  | zero =>
    intro t ht
    exact ⟨0,by simp,by simp only [Nat.mul_zero,Nat.zero_mod]; omega⟩
  | succ e ih =>
    intro t ht
    let M := 2^e
    have hM : 0<M := Nat.two_pow_pos e
    have hpow : 2^(e+1)=2*M := by simp only [M,Nat.pow_succ,Nat.mul_comm]
    rw [hpow] at ht ⊢
    obtain ⟨a,ha,he⟩ := ih (t%M) (Nat.mod_lt _ hM)
    have hd : M∣2*M := Nat.dvd_mul_left M 2
    have hm : ((k*a)%(2*M))%M=t%M := by rw [Nat.mod_mod_of_dvd _ hd]; exact he
    rcases two_lifts hM (Nat.mod_lt _ (by omega)) ht hm with hx | hx
    · exact ⟨a,by omega,hx⟩
    · refine ⟨a+M,by omega,?_⟩
      have hkM : (k*M)%(2*M)=M := by
        rw [Nat.mul_mod_mul_right M k 2,hk,Nat.one_mul]
      rw [Nat.mul_add,Nat.add_mod,hkM]
      exact hx

theorem odd_mul_mod_surjective {k e : Nat} (hk : k%2=1) :
    Function.Surjective (fun a : Fin (2^e) => (⟨(k*a.val)%(2^e),Nat.mod_lt _ (Nat.two_pow_pos e)⟩ : Fin (2^e))) := by
  intro t
  obtain ⟨a,ha,he⟩ := odd_mul_mod_surjective_nat hk e t.val t.isLt
  exact ⟨⟨a,ha⟩,Fin.ext he⟩

def indicator {N : Nat} (S : Fin N → Bool) (n : Nat) : Nat :=
  if hn : n<N then (S ⟨n,hn⟩).toNat else 0

def prefixCount {N : Nat} (S : Fin N → Bool) : Nat → Nat
  | 0 => 0
  | n+1 => prefixCount S n+indicator S n

def cardinality {N : Nat} (S : Fin N → Bool) : Nat := prefixCount S N

def colorSet {N : Nat} (S : Fin N → Bool) (color : Bool) : Fin N → Bool := fun h => S h ^^ color

/-- The actual uniform round/height vertex formula; no Hamilton property is
part of its input. -/
def profileVertex {N : Nat} (hN : 0<N) (S : Fin N → Bool) (a : Fin N × Fin N) : Vertex N :=
  let x : Fin N := ⟨(a.1.val*cardinality S+prefixCount S a.2.val)%N,Nat.mod_lt _ hN⟩
  (x,backward hN a.2 x)

theorem profileVertex_height {N : Nat} (hN : 0<N) (S : Fin N → Bool) (a : Fin N × Fin N) :
    height hN (profileVertex hN S a)=a.2 := by
  exact forward_inverse hN _ _

def roundResidue {N : Nat} (hN : 0<N) (S : Fin N → Bool) (a : Fin N) : Fin N :=
  ⟨(cardinality S*a.val)%N,Nat.mod_lt _ hN⟩
def prefixResidue {N : Nat} (hN : 0<N) (S : Fin N → Bool) (h : Fin N) : Fin N :=
  ⟨prefixCount S h.val%N,Nat.mod_lt _ hN⟩

theorem profileVertex_first {N : Nat} (hN : 0<N) (S : Fin N → Bool) (a : Fin N × Fin N) :
    (profileVertex hN S a).1=forward hN (prefixResidue hN S a.2) (roundResidue hN S a.1) := by
  apply Fin.ext
  simp only [profileVertex,forward,prefixResidue,roundResidue]
  rw [←Nat.add_mod]
  congr 1
  simp only [Nat.add_comm,Nat.mul_comm]

theorem profileVertex_injective {e : Nat} (S : Fin (2^e) → Bool) (hodd : cardinality S%2=1) :
    Function.Injective (profileVertex (Nat.two_pow_pos e) S) := by
  intro a b he
  have hh : a.2=b.2 := by
    have hh := congrArg (height (Nat.two_pow_pos e)) he
    simpa only [profileVertex_height] using hh
  rcases a with ⟨a,h⟩
  rcases b with ⟨b,h'⟩
  change h=h' at hh
  subst h'
  have hx := congrArg Prod.fst he
  rw [profileVertex_first,profileVertex_first] at hx
  have hr := forward_injective (Nat.two_pow_pos e) (prefixResidue (Nat.two_pow_pos e) S h) hx
  have hab := odd_mul_mod_injective hodd (congrArg Fin.val hr)
  exact Prod.ext hab rfl

theorem profileVertex_surjective {e : Nat} (S : Fin (2^e) → Bool) (hodd : cardinality S%2=1) :
    Function.Surjective (profileVertex (Nat.two_pow_pos e) S) := by
  intro u
  let h := height (Nat.two_pow_pos e) u
  let p := prefixResidue (Nat.two_pow_pos e) S h
  let r := backward (Nat.two_pow_pos e) u.1 p
  obtain ⟨a,ha⟩ := odd_mul_mod_surjective hodd r
  change roundResidue (Nat.two_pow_pos e) S a=r at ha
  have hx : (profileVertex (Nat.two_pow_pos e) S (a,h)).1=u.1 := by
    rw [profileVertex_first,ha]
    exact forward_inverse (Nat.two_pow_pos e) p u.1
  have hy : (profileVertex (Nat.two_pow_pos e) S (a,h)).2=u.2 := by
    change backward (Nat.two_pow_pos e) h (profileVertex (Nat.two_pow_pos e) S (a,h)).1=u.2
    rw [hx]
    apply forward_injective (Nat.two_pow_pos e) u.1
    rw [forward_inverse]
    rfl
  exact ⟨(a,h),Prod.ext hx hy⟩

/-- Actual numeric profile vertex tour, visiting every torus vertex once. -/
def profileTour {N : Nat} (hN : 0<N) (S : Fin N → Bool) (t : Fin (N*N)) : Vertex N :=
  profileVertex hN S (pairCoordinates hN t)

theorem profileTour_injective {e : Nat} (S : Fin (2^e) → Bool) (hodd : cardinality S%2=1) :
    Function.Injective (profileTour (Nat.two_pow_pos e) S) := by
  intro t u he
  have hp := profileVertex_injective S hodd he
  have hh := congrArg pairIndex hp
  simpa only [pairIndex_coordinates] using hh

theorem profileTour_surjective {e : Nat} (S : Fin (2^e) → Bool) (hodd : cardinality S%2=1) :
    Function.Surjective (profileTour (Nat.two_pow_pos e) S) := by
  intro v
  obtain ⟨a,ha⟩ := profileVertex_surjective S hodd v
  exact ⟨pairIndex a,by simpa only [profileTour,pairCoordinates_index] using ha⟩

/-- The numeric clock has the exact physical SUM-height residue. -/
theorem profileTour_sum_clock {N : Nat} (hN : 0<N) (S : Fin N → Bool) (t : Fin (N*N)) :
    t.val%N=(height hN (profileTour hN S t)).val := by
  rw [profileTour,profileVertex_height]
  rfl

def coordinateNext {N : Nat} (hN : 0<N) (a : Fin N × Fin N) : Fin N × Fin N :=
  if a.2.val+1<N then (a.1,successor hN a.2) else (successor hN a.1,⟨0,hN⟩)

theorem coordinateNext_height {N : Nat} (hN : 0<N) (a : Fin N × Fin N) :
    (coordinateNext hN a).2=successor hN a.2 := by
  unfold coordinateNext
  split
  · rfl
  · apply Fin.ext
    have he : a.2.val+1=N := by have := a.2.isLt; omega
    simp only [successor,he,Nat.mod_self]

theorem profile_first_advance {N : Nat} (hN : 0<N) (S : Fin N → Bool) (a : Fin N × Fin N) :
    (profileVertex hN S (coordinateNext hN a)).1.val=
      (a.1.val*cardinality S+prefixCount S a.2.val+indicator S a.2.val)%N := by
  unfold coordinateNext
  split
  · have hn : (successor hN a.2).val=a.2.val+1 := Nat.mod_eq_of_lt (by assumption)
    simp only [profileVertex,hn,prefixCount,Nat.add_assoc]
  · have hn : a.2.val+1=N := by have := a.2.isLt; omega
    have hc : prefixCount S a.2.val+indicator S a.2.val=cardinality S := by
      rw [←prefixCount,Nat.succ_eq_add_one,hn]
      rfl
    simp only [profileVertex,prefixCount,Nat.add_zero,successor,Nat.mod_mul_mod]
    rw [Nat.add_mul,Nat.one_mul,Nat.add_assoc,hc]

theorem vertex_eq_of_first_height {N : Nat} (hN : 0<N) {u v : Vertex N}
    (hx : u.1=v.1) (hh : height hN u=height hN v) : u=v := by
  apply Prod.ext hx
  apply forward_injective hN v.1
  simpa only [height,hx] using hh

theorem profileVertex_next {N : Nat} (hN : 0<N) (S : Fin N → Bool) (a : Fin N × Fin N) :
    profileVertex hN S (coordinateNext hN a)=step hN S false (profileVertex hN S a) := by
  apply vertex_eq_of_first_height hN
  · apply Fin.ext
    rw [profile_first_advance]
    have hind : indicator S a.2.val=(S a.2).toNat := by
      simp only [indicator,dite_eq_left a.2.isLt]
    rw [hind]
    unfold step
    rw [profileVertex_height,Bool.xor_false]
    cases hs : S a.2
    · simp only [Bool.false_eq_true,↓reduceIte,Bool.toNat_false,Nat.add_zero,profileVertex]
    · simp only [↓reduceIte,Bool.toNat_true,successor,profileVertex,Nat.mod_add_mod]
  · rw [profileVertex_height,height_step,profileVertex_height,coordinateNext_height]

theorem pairIndex_next {N : Nat} (hN : 0<N) (a : Fin N × Fin N) :
    pairIndex (coordinateNext hN a)=successor (Nat.mul_pos hN hN) (pairIndex a) := by
  apply Fin.ext
  unfold coordinateNext
  split
  · have hh : (successor hN a.2).val=a.2.val+1 := Nat.mod_eq_of_lt (by assumption)
    have hm := Nat.mul_le_mul_left N (show a.1.val+1≤N by omega)
    rw [Nat.mul_add,Nat.mul_one] at hm
    have ht : N*a.1.val+a.2.val+1<N*N := by omega
    simp only [pairIndex]
    rw [hh]
    simp only [successor,Nat.mod_eq_of_lt ht]
    omega
  · have hh : a.2.val+1=N := by have := a.2.isLt; omega
    by_cases ha : a.1.val+1<N
    · have hr : (successor hN a.1).val=a.1.val+1 := Nat.mod_eq_of_lt ha
      have ht := Nat.mul_lt_mul_of_pos_left ha hN
      rw [Nat.mul_add,Nat.mul_one] at ht
      have hv : N*a.1.val+a.2.val+1=N*a.1.val+N := by omega
      simp only [pairIndex]
      rw [hr]
      simp only [successor,hv,Nat.mod_eq_of_lt ht,Nat.add_zero]
      rw [Nat.mul_add,Nat.mul_one]
    · have hr : a.1.val+1=N := by have := a.1.isLt; omega
      have hz : (successor hN a.1).val=0 := by simp only [successor,hr,Nat.mod_self]
      have ht := congrArg (fun x : Nat => N*x) hr
      rw [Nat.mul_add,Nat.mul_one] at ht
      have hv : N*a.1.val+a.2.val+1=N*N := by omega
      simp only [pairIndex]
      rw [hz]
      simp only [successor,hv,Nat.mod_self,Nat.mul_zero,Nat.zero_add]

theorem pairCoordinates_next {N : Nat} (hN : 0<N) (t : Fin (N*N)) :
    pairCoordinates hN (successor (Nat.mul_pos hN hN) t)=coordinateNext hN (pairCoordinates hN t) := by
  have he := pairIndex_next hN (pairCoordinates hN t)
  rw [pairIndex_coordinates] at he
  have hh := congrArg (pairCoordinates hN) he
  simpa only [pairCoordinates_index] using hh.symm

/-- Exact forced numeric successor of the actual profile tour, including
every round seam and the final cyclic wrap. -/
theorem profileTour_next {N : Nat} (hN : 0<N) (S : Fin N → Bool) (t : Fin (N*N)) :
    profileTour hN S (successor (Nat.mul_pos hN hN) t)=step hN S false (profileTour hN S t) := by
  rw [profileTour,pairCoordinates_next,profileVertex_next]
  rfl

theorem prefixCount_complement {N : Nat} (S : Fin N → Bool) (n : Nat) (hn : n≤N) :
    prefixCount S n+prefixCount (colorSet S true) n=n := by
  induction n with
  | zero => rfl
  | succ n ih =>
    have hp := ih (by omega)
    have hb : indicator S n+indicator (colorSet S true) n=1 := by
      have hi : n<N := by omega
      simp only [indicator,dite_eq_left hi,colorSet,Bool.xor_true]
      cases S ⟨n,hi⟩ <;> rfl
    simp only [prefixCount]
    omega

theorem complementary_count_odd {e : Nat} (he : 1≤e) (S : Fin (2^e) → Bool)
    (hodd : cardinality S%2=1) : cardinality (colorSet S true)%2=1 := by
  have hc := prefixCount_complement S (2^e) (Nat.le_refl _)
  change cardinality S+cardinality (colorSet S true)=2^e at hc
  have hd : 2∣2^e := by simpa only [Nat.pow_one] using Nat.pow_dvd_pow 2 he
  have heven := Nat.mod_eq_zero_of_dvd hd
  have hm := congrArg (fun n : Nat => n%2) hc
  rw [Nat.add_mod,hodd,heven] at hm
  have hr := Nat.mod_lt (cardinality (colorSet S true)) (show 0<2 by decide)
  omega

theorem color_count_odd {e : Nat} (he : 1≤e) (S : Fin (2^e) → Bool)
    (hodd : cardinality S%2=1) (color : Bool) : cardinality (colorSet S color)%2=1 := by
  cases color
  · have hs : colorSet S false=S := by funext h; exact Bool.xor_false _
    rw [hs]
    exact hodd
  · exact complementary_count_odd he S hodd

def profileCycles {N : Nat} (hN : 0<N) (S : Fin N → Bool) (color : Bool) : Fin (N*N) → Vertex N :=
  profileTour hN (colorSet S color)

theorem profileCycles_injective {e : Nat} (he : 1≤e) (S : Fin (2^e) → Bool)
    (hodd : cardinality S%2=1) (color : Bool) :
    Function.Injective (profileCycles (Nat.two_pow_pos e) S color) :=
  profileTour_injective (colorSet S color) (color_count_odd he S hodd color)

theorem profileCycles_surjective {e : Nat} (he : 1≤e) (S : Fin (2^e) → Bool)
    (hodd : cardinality S%2=1) (color : Bool) :
    Function.Surjective (profileCycles (Nat.two_pow_pos e) S color) :=
  profileTour_surjective (colorSet S color) (color_count_odd he S hodd color)

theorem profileCycles_next {N : Nat} (hN : 0<N) (S : Fin N → Bool) (color : Bool) (t : Fin (N*N)) :
    profileCycles hN S color (successor (Nat.mul_pos hN hN) t)=
      step hN S color (profileCycles hN S color t) := by
  have h := profileTour_next hN (colorSet S color) t
  have hs : step hN (colorSet S color) false=step hN S color := by
    funext u
    simp only [step,colorSet,Bool.xor_false]
  rw [hs] at h
  exact h

theorem profileCycles_adjacent {N : Nat} (hN : 0<N) (S : Fin N → Bool) (color : Bool) (t : Fin (N*N)) :
    TorusAdjacent hN (profileCycles hN S color t)
      (profileCycles hN S color (successor (Nat.mul_pos hN hN) t)) := by
  rw [profileCycles_next]
  refine ⟨stepLabel hN S color (profileCycles hN S color t),?_⟩
  rw [step_decodes]
  exact Or.inl rfl

theorem profileCycles_edges_cover {e : Nat} (he : 1≤e) (S : Fin (2^e) → Bool)
    (hodd : cardinality S%2=1) {u v : Vertex (2^e)} (h : TorusAdjacent (Nat.two_pow_pos e) u v) :
    ∃ color t, SameEdge (profileCycles (Nat.two_pow_pos e) S color t,
      profileCycles (Nat.two_pow_pos e) S color (successor (Nat.mul_pos (Nat.two_pow_pos e) (Nat.two_pow_pos e)) t)) (u,v) := by
  obtain ⟨color,x,hx⟩ := actual_edges_cover (Nat.two_pow_pos e) S h
  obtain ⟨t,ht⟩ := profileCycles_surjective he S hodd color x
  refine ⟨color,t,?_⟩
  rw [profileCycles_next,ht]
  exact hx

theorem profileCycles_edges_unique {e : Nat} (he : 2≤e) (S : Fin (2^e) → Bool)
    (hodd : cardinality S%2=1) {color color' : Bool} {t t' : Fin ((2^e)*(2^e))}
    (h : SameEdge (profileCycles (Nat.two_pow_pos e) S color t,
      profileCycles (Nat.two_pow_pos e) S color (successor (Nat.mul_pos (Nat.two_pow_pos e) (Nat.two_pow_pos e)) t))
      (profileCycles (Nat.two_pow_pos e) S color' t',
      profileCycles (Nat.two_pow_pos e) S color' (successor (Nat.mul_pos (Nat.two_pow_pos e) (Nat.two_pow_pos e)) t'))) :
    color=color' ∧ t=t' := by
  have h3 : 3≤2^e := by
    have hp := Nat.pow_le_pow_right (show 1≤2 by decide) he
    omega
  rw [profileCycles_next,profileCycles_next] at h
  obtain ⟨hc,ht⟩ := actual_edges_unique (Nat.two_pow_pos e) h3 S h
  subst color'
  exact ⟨rfl,profileCycles_injective (by omega) S hodd color ht⟩

theorem profileCycles_sum_clock {N : Nat} (hN : 0<N) (S : Fin N → Bool) (color : Bool) (t : Fin (N*N)) :
    t.val%N=(height hN (profileCycles hN S color t)).val :=
  profileTour_sum_clock hN (colorSet S color) t

/-- Actual inverse numeric profile clocks, for use by later source lifts. -/
noncomputable def profileClockData {e : Nat} (he : 1≤e) (S : Fin (2^e) → Bool)
    (hodd : cardinality S%2=1) (color : Bool) : ClockData (Vertex (2^e)) ((2^e)*(2^e)) where
  cycle := profileCycles (Nat.two_pow_pos e) S color
  position := fun v => Classical.choose (profileCycles_surjective he S hodd color v)
  position_cycle := by
    intro t
    apply profileCycles_injective he S hodd color
    exact Classical.choose_spec (profileCycles_surjective he S hodd color (profileCycles (Nat.two_pow_pos e) S color t))
  cycle_position := fun v => Classical.choose_spec (profileCycles_surjective he S hodd color v)

theorem profileClock_sum {e : Nat} (he : 1≤e) (S : Fin (2^e) → Bool)
    (hodd : cardinality S%2=1) (color : Bool) (v : Vertex (2^e)) :
    ((profileClockData he S hodd color).position v).val%(2^e)=(height (Nat.two_pow_pos e) v).val := by
  have h := profileCycles_sum_clock (Nat.two_pow_pos e) S color ((profileClockData he S hodd color).position v)
  rw [show profileCycles (Nat.two_pow_pos e) S color ((profileClockData he S hodd color).position v)=v
    from (profileClockData he S hodd color).cycle_position v] at h
  exact h

theorem profileClock_mod {e D : Nat} (he : 1≤e) (hD : D∣2^e) (S : Fin (2^e) → Bool)
    (hodd : cardinality S%2=1) (color : Bool) (v : Vertex (2^e)) :
    ((profileClockData he S hodd color).position v).val%D=(v.1.val+v.2.val)%D := by
  calc
    _ = (((profileClockData he S hodd color).position v).val%(2^e))%D := (Nat.mod_mod_of_dvd _ hD).symm
    _ = (height (Nat.two_pow_pos e) v).val%D := congrArg (fun n : Nat => n%D) (profileClock_sum he S hodd color v)
    _ = _ := Nat.mod_mod_of_dvd _ hD

/-- Uniform actual Hamilton decomposition of the power-of-two torus for every
odd-cardinality horizontal height set. -/
theorem positive_profile_decomposition {e : Nat} (he : 2≤e) (S : Fin (2^e) → Bool)
    (hodd : cardinality S%2=1) :
    ∃ C : Bool → Fin ((2^e)*(2^e)) → Vertex (2^e),
      (∀ color, Function.Injective (C color) ∧ Function.Surjective (C color)) ∧
      (∀ color t, TorusAdjacent (Nat.two_pow_pos e) (C color t)
        (C color (successor (Nat.mul_pos (Nat.two_pow_pos e) (Nat.two_pow_pos e)) t))) ∧
      (∀ u v, TorusAdjacent (Nat.two_pow_pos e) u v → ∃ color t,
        SameEdge (C color t,C color (successor (Nat.mul_pos (Nat.two_pow_pos e) (Nat.two_pow_pos e)) t)) (u,v)) ∧
      (∀ color t color' t', SameEdge
        (C color t,C color (successor (Nat.mul_pos (Nat.two_pow_pos e) (Nat.two_pow_pos e)) t))
        (C color' t',C color' (successor (Nat.mul_pos (Nat.two_pow_pos e) (Nat.two_pow_pos e)) t')) →
          color=color' ∧ t=t') := by
  refine ⟨profileCycles (Nat.two_pow_pos e) S,?_,profileCycles_adjacent (Nat.two_pow_pos e) S,?_,?_⟩
  · intro color
    exact ⟨profileCycles_injective (by omega) S hodd color,profileCycles_surjective (by omega) S hodd color⟩
  · intro u v h
    exact profileCycles_edges_cover (by omega) S hodd h
  · intro color t color' t' h
    exact profileCycles_edges_unique he S hodd h

/-- Both complementary cycles share the literal balanced-prefix endpoint.
This is the common-A arc mechanism with A=2u; all intervening vertices are
simple because the full tours are already injective. -/
theorem balanced_prefix_endpoint {N u : Nat} (hN : 0<N) (hu : 2*u<N)
    (S : Fin N → Bool) (hp : prefixCount S (2*u)=u) (color : Bool) :
    profileVertex hN (colorSet S color) (⟨0,hN⟩,⟨2*u,hu⟩)=
      (⟨u,by omega⟩,⟨u,by omega⟩) := by
  have hpc : prefixCount (colorSet S color) (2*u)=u := by
    cases color
    · have hs : colorSet S false=S := by funext h; exact Bool.xor_false _
      rw [hs]
      exact hp
    · have hc := prefixCount_complement S (2*u) (by omega)
      rw [hp] at hc
      omega
  apply Prod.ext
  · apply Fin.ext
    simp only [profileVertex,hpc,Nat.zero_mul,Nat.zero_add,Nat.mod_eq_of_lt (show u<N by omega)]
  · apply Fin.ext
    simp only [profileVertex,hpc,Nat.zero_mul,Nat.zero_add,Nat.mod_eq_of_lt (show u<N by omega),backward]
    have hx : N-u+2*u=N+u := by omega
    rw [hx,Nat.add_mod_left,Nat.mod_eq_of_lt (show u<N by omega)]

/-- Uniform profile height sets used by the geometric construction:
S={0,...,u−1}∪{2u}; u=0 gives the singleton {0}. -/
def intervalWithEndpoint {N : Nat} (u : Nat) : Fin N → Bool := fun h => decide (h.val<u ∨ h.val=2*u)

theorem intervalWithEndpoint_indicator {N u n : Nat} (hn : n<N) :
    indicator (intervalWithEndpoint (N:=N) u) n=if n<u ∨ n=2*u then 1 else 0 := by
  simp only [indicator,dite_eq_left hn,intervalWithEndpoint]
  split <;> simp_all

theorem intervalWithEndpoint_prefix {N : Nat} (u n : Nat) (hn : n≤N) :
    prefixCount (intervalWithEndpoint (N:=N) u) n=Nat.min n u+(if 2*u<n then 1 else 0) := by
  induction n with
  | zero => simp [prefixCount]
  | succ n ih =>
    rw [prefixCount,ih (by omega),intervalWithEndpoint_indicator (by omega)]
    simp only [Nat.min_def]
    split <;> split <;> split <;> split <;> split <;> omega

theorem intervalWithEndpoint_cardinality {N u : Nat} (hu : 2*u<N) :
    cardinality (intervalWithEndpoint (N:=N) u)=u+1 := by
  rw [cardinality,intervalWithEndpoint_prefix u N (Nat.le_refl _)]
  simp only [Nat.min_def,ite_eq_left hu]
  split <;> omega

theorem intervalWithEndpoint_odd {N u : Nat} (hu : 2*u<N) (heven : u%2=0) :
    cardinality (intervalWithEndpoint (N:=N) u)%2=1 := by
  rw [intervalWithEndpoint_cardinality hu,Nat.add_mod,heven]

theorem intervalWithEndpoint_balanced_prefix {N u : Nat} (hu : 2*u<N) :
    prefixCount (intervalWithEndpoint (N:=N) u) (2*u)=u := by
  rw [intervalWithEndpoint_prefix u (2*u) (by omega)]
  simp only [Nat.min_def,ite_eq_right (show ¬2*u<2*u by omega),Nat.add_zero]
  split <;> omega

